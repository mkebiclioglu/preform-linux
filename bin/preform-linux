#!/usr/bin/env bash
# preform-linux: run Formlabs PreFormServer (the headless PreForm API) on Linux under Wine.
#
#   preform-linux install [--force]   download, verify and install PreFormServer, set up the Wine prefix
#   preform-linux run [-- args]       start PreFormServer in the foreground (Xvfb + Wine)
#   preform-linux doctor              report what is installed and what is missing
#   preform-linux printers [ip ...]   probe printers by IP on the running server, then list devices
#   preform-linux login               log the running server in to Formlabs (Fleet Control, Dashboard)
#   preform-linux wine <args>         run a Wine command inside the preform-linux prefix
#   preform-linux uninstall           remove the install directory and Wine prefix
#
# Environment:
#   PREFORM_LINUX_HOME        install root (default: $XDG_DATA_HOME/preform-linux)
#   PREFORM_PORT              HTTP port PreFormServer listens on (default: 44388)
#   PREFORM_VERSION           "latest" (default) or an exact release such as 3.63.0
#   PREFORM_PRINTERS          printer IPs/hostnames (comma or space separated) probed once the server is up
#   PREFORM_PRINTERS_TIMEOUT  seconds to wait for each probed printer (default: 10)
#   PREFORM_PRINTERS_INTERVAL seconds between re-probes so /devices/ stays fresh (default: 600; 0 = once)
#   FORMLABS_USERNAME, FORMLABS_PASSWORD, FORMLABS_ACCESS_TOKEN
#                             Formlabs account; the server logs in once it is up (Fleet Control, Dashboard)
#   FORMLABS_PASSWORD_FILE, FORMLABS_ACCESS_TOKEN_FILE
#                             read the secret from a file instead (Docker/Podman secrets)
#   PREFORM_TELEMETRY         1 allows PreFormServer telemetry (default: off)
#   PREFORM_INSTALL_UNVERIFIED 1 accepts a download whose Authenticode signature cannot be checked
#   PREFORM_SHIM              0 never installs the dnsapi shim, 1 always does (default: only when Wine < 11.13)
#   PREFORM_WINE_UNCHECKED    1 skips the Wine >= 11.5 requirement check
#   PREFORM_XVFB              0 uses the existing $DISPLAY, 1 always starts Xvfb (default: Xvfb when no DISPLAY)
#   PREFORM_STARTUP_TIMEOUT   seconds to wait for "READY FOR INPUT" before giving up (default: 300; 0 disables)
#   PREFORM_SHIM_TRACE        1 makes the dnsapi shim log the mDNS queries PreFormServer asks for
#   QT_OPENGL                 Qt renderer, default "software" (PreFormServer's bundled Mesa; no GPU needed)
#   WINEDEBUG                 Wine log channels (default: -all)
set -euo pipefail

PREFORM_LINUX_VERSION="0.2.1"
PREFORM_LINUX_HOME="${PREFORM_LINUX_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/preform-linux}"
PREFORM_PORT="${PREFORM_PORT:-44388}"
PREFORM_VERSION="${PREFORM_VERSION:-latest}"
PREFORM_STARTUP_TIMEOUT="${PREFORM_STARTUP_TIMEOUT:-300}"
PREFORM_PRINTERS="${PREFORM_PRINTERS:-}"
PREFORM_PRINTERS_TIMEOUT="${PREFORM_PRINTERS_TIMEOUT:-10}"
PREFORM_PRINTERS_INTERVAL="${PREFORM_PRINTERS_INTERVAL:-600}"
READY_TOKEN="READY FOR INPUT"
DOWNLOAD_PAGE="https://formlabs.com/support/Formlabs-API-downloads-and-release-notes"
# Only this layout on this host is accepted, whatever the downloads page says.
RELEASE_URL_RE='^https://downloads\.formlabs\.com/PreFormServer/Release/[0-9]+\.[0-9]+\.[0-9]+/PreForm_Server_win_[A-Za-z0-9._-]+\.zip$'
# Wine 11.5 added icu/icuuc/icuin, which PreFormServer 3.63.0's Qt6Core imports; older Wine cannot load it.
WINE_MIN="11.5"
# Wine gained DnsStartMulticastQuery/DnsStopMulticastQuery in 11.13 (commits c13fd5de90, 11bca8ddea).
WINE_MIN_FOR_NO_SHIM="11.13"
MS_ROOT_FINGERPRINT="53:67:F2:0C:7A:DE:0E:2B:CA:79:09:15:05:6D:08:6B:72:0C:33:C1:FA:2A:26:61:AC:F7:87:E3:29:2E:12:70"

INSTALL_DIR="$PREFORM_LINUX_HOME/PreFormServer"
EXE="$INSTALL_DIR/PreFormServer.exe"
META="$PREFORM_LINUX_HOME/installed.env"
export WINEPREFIX="${WINEPREFIX:-$PREFORM_LINUX_HOME/prefix}"
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree=d;mshtml=d}"

self_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
repo_dir="$(cd "$self_dir/.." && pwd)"
CERT="$repo_dir/certs/microsoft-identity-verification-root-2020.pem"
SHIM_SRC="$repo_dir/shim"

log()  { printf '[preform-linux] %s\n' "$*" >&2; }
die()  { log "error: $*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Ubuntu's wine64 package ships only /usr/bin/wine64; WineHQ and most distros ship wine.
WINE="${WINE:-}"
if [ -z "$WINE" ]; then
  if have wine; then WINE=wine; elif have wine64; then WINE=wine64; else WINE=wine; fi
fi
have_wine() { have "$WINE"; }

version_ge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" = "$2" ]; }

wine_version() {
  have_wine || return 1
  "$WINE" --version 2>/dev/null | sed -n 's/^wine-\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p'
}

check_wine_version() {
  local v
  v="$(wine_version)"
  [ -n "$v" ] || die "could not parse the output of $WINE --version"
  version_ge "$v" "$WINE_MIN" || die "Wine $v is too old: PreFormServer needs the ICU DLLs Wine added in $WINE_MIN (WineHQ devel or staging; distro packages such as Ubuntu's 9.0 will not do). Set PREFORM_WINE_UNCHECKED=1 to try anyway."
}
[ "${PREFORM_WINE_UNCHECKED:-0}" = "1" ] && check_wine_version() { :; }

needs_shim() {
  case "${PREFORM_SHIM:-}" in
    0) return 1 ;;
    1) return 0 ;;
  esac
  local v
  v="$(wine_version)" || return 0
  ! version_ge "$v" "$WINE_MIN_FOR_NO_SHIM"
}

installed_version() { if [ -f "$META" ]; then sed -n 's/^version=//p' "$META"; fi; }

# --- release discovery -------------------------------------------------------

latest_release_url() {
  local html
  html="$(curl -fsSL --max-time 30 -A "preform-linux/$PREFORM_LINUX_VERSION" "$DOWNLOAD_PAGE")" || die "could not read $DOWNLOAD_PAGE"
  printf '%s' "$html" \
    | grep -oE 'https://downloads\.formlabs\.com/PreFormServer/Release/[0-9.]+/PreForm_Server_win_[A-Za-z0-9._-]+\.zip' \
    | sort -u \
    | awk -F/ '{ print $6 " " $0 }' \
    | sort -k1,1V \
    | { if [ "$PREFORM_VERSION" = "latest" ]; then tail -n1; else awk -v v="$PREFORM_VERSION" '$1 == v' | tail -n1; fi; } \
    | awk '{ print $2 }'
}

# --- verification --------------------------------------------------------------

check_pinned_root() {
  [ -f "$CERT" ] || die "missing trust anchor $CERT"
  have openssl || return 0
  local fp
  fp="$(openssl x509 -in "$CERT" -noout -fingerprint -sha256 | sed 's/^.*=//')"
  [ "${fp^^}" = "$MS_ROOT_FINGERPRINT" ] || die "trust anchor fingerprint mismatch: $fp"
}

# True when some "Subject:" line carries both CN=Formlabs Inc. and O=Formlabs Inc.
# (osslsigncode prints "CN=..., O=..." or OpenSSL's legacy "/C=US/.../CN=..." form).
subjects_name_formlabs() {
  local subj
  while IFS= read -r subj; do
    if grep -qE '(^|[,/] *)CN=Formlabs Inc\.( *[,/]|$)' <<<"$subj" && grep -qE '(^|[,/] *)O=Formlabs Inc\.( *[,/]|$)' <<<"$subj"; then
      return 0
    fi
  done < <(sed -n 's/^.*Subject: *//p' <<<"$1")
  return 1
}

verify_authenticode() {
  local exe="$1" out
  if ! have osslsigncode; then
    [ "${PREFORM_INSTALL_UNVERIFIED:-0}" = "1" ] && { log "WARNING: osslsigncode not installed; accepting the download on HTTPS alone (PREFORM_INSTALL_UNVERIFIED=1)"; return 0; }
    die "osslsigncode is not installed, so the Formlabs code signature cannot be checked. Install it (apt/dnf install osslsigncode) or set PREFORM_INSTALL_UNVERIFIED=1."
  fi
  check_pinned_root
  out="$(osslsigncode verify -in "$exe" -CAfile "$CERT" -TSA-CAfile "$CERT" 2>&1 || true)"
  if grep -qE '^Signature verification: ok$' <<<"$out" \
     && ! grep -qE '^(Timestamp Server )?Signature verification: failed$' <<<"$out" \
     && subjects_name_formlabs "$out"; then
    log "Authenticode signature OK: Formlabs Inc. (chain anchored on the pinned Microsoft root)"
    return 0
  fi
  [ "${PREFORM_INSTALL_UNVERIFIED:-0}" = "1" ] && { log "WARNING: signature check failed but PREFORM_INSTALL_UNVERIFIED=1 is set; continuing"; return 0; }
  printf '%s\n' "$out" | grep -iE 'verification|error|failed|subject' | tail -n 6 >&2
  die "PreFormServer.exe failed the Authenticode check; refusing to install"
}

check_zip_entries() {
  local entries
  entries="$(unzip -Z1 "$1")"
  grep -qx 'PreFormServer/PreFormServer.exe' <<<"$entries" || die "archive does not contain PreFormServer/PreFormServer.exe"
  if grep -qE '(^/|^[A-Za-z]:|(^|/)\.\.(/|$)|\\)' <<<"$entries"; then die "archive contains unsafe paths; refusing to extract"; fi
  if grep -vqE '^PreFormServer/' <<<"$entries"; then die "archive contains entries outside PreFormServer/; refusing to extract"; fi
}

# --- shim --------------------------------------------------------------------------

build_shim() {
  local out="$1"
  if [ -n "${PREFORM_SHIM_DLL:-}" ] && [ -f "$PREFORM_SHIM_DLL" ]; then cp "$PREFORM_SHIM_DLL" "$out"; return 0; fi
  have x86_64-w64-mingw32-gcc || die "Wine $(wine_version) needs the dnsapi shim (Wine < $WINE_MIN_FOR_NO_SHIM), which is built with x86_64-w64-mingw32-gcc. Install gcc-mingw-w64-x86-64, or point PREFORM_SHIM_DLL at a prebuilt shim/dnsapi.dll, or upgrade Wine and set PREFORM_SHIM=0."
  make -s -C "$SHIM_SRC" >&2
  cp "$SHIM_SRC/dnsapi.dll" "$out"
}

# --- prefix ----------------------------------------------------------------------

with_display() {
  # Run "$@" with a display: the caller's, or a throwaway Xvfb.
  if [ -n "${DISPLAY:-}" ] && [ "${PREFORM_XVFB:-0}" != "1" ]; then "$@"; else
    have xvfb-run || die "xvfb-run is not installed (apt install xvfb)"
    xvfb-run -a -s "-screen 0 1280x1024x24 -nolisten tcp" "$@"
  fi
}

disable_winedbg() {
  # Never auto-attach winedbg: a crashed PreFormServer must exit, not hang for a debugger.
  "$WINE" reg add 'HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion\\AeDebug' /v Auto /t REG_DWORD /d 0 /f >/dev/null 2>&1 || true
}

init_prefix() {
  mkdir -p "$WINEPREFIX"
  log "initialising Wine prefix at $WINEPREFIX (takes a minute the first time)"
  with_display timeout 600 "$WINE" wineboot --init >/dev/null 2>&1 || die "wineboot --init failed or timed out"
  disable_winedbg
  # Wine 11 keeps services.exe & co. alive after wineboot, so waiting for the server to exit
  # would hang; give it a moment and then shut the prefix down explicitly.
  # (SIGTERM first so the server writes the registry; SIGKILL if it lingers.)
  timeout 20 wineserver -w 2>/dev/null || { wineserver -k15 2>/dev/null; sleep 2; wineserver -k 2>/dev/null; } || true
}

# --- talking to a running PreFormServer ------------------------------------------------

API_BASE="http://127.0.0.1:$PREFORM_PORT"

# First top-level-ish "KEY":"value" / "KEY":123 on stdin. Good enough for the small
# operation and device documents PreFormServer returns; no python needed in the image.
json_str() { grep -oE "\"$1\" *: *\"[^\"]*\"" | head -n1 | sed 's/^[^:]*: *"//; s/"$//'; }
json_num() { grep -oE "\"$1\" *: *-?[0-9]+" | head -n1 | sed 's/^[^:]*: *//'; }
json_escape() { sed 's/[\\"]/\\&/g' <<<"$1"; }

api_up() { local code; code="$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$API_BASE/" || true)"; [ "$code" != "000" ] && [ "$code" -lt 500 ]; }

api_get() { curl -sS -m 30 "$API_BASE$1"; }

# POST a JSON body read from a variable (never on the command line: it may hold a password).
api_post() { printf '%s' "$2" | curl -sS -m "${3:-60}" -X POST -H 'Content-Type: application/json' -d @- "$API_BASE$1"; }

# Start an async operation and wait for it. Prints the final operation document.
# Returns 1 when it FAILED or the wait ran out.
api_op() { # api_op PATH JSON-BODY [max-seconds]
  local path="$1" body="$2" max="${3:-120}" accepted id deadline o
  accepted="$(printf '%s' "$body" | curl -sS -m 30 -X POST -H 'Content-Type: application/json' -d @- "$API_BASE$path?async=true")" || return 1
  id="$(json_str operationId <<<"$accepted")"
  if [ -z "$id" ]; then printf '%s\n' "$accepted"; return 0; fi
  deadline=$((SECONDS + max))
  while :; do
    o="$(api_get "/operations/$id/")" || return 1
    # The operation's own status, not a device's: only these two words end an operation.
    if grep -qE '"status" *: *"SUCCEEDED"' <<<"$o"; then printf '%s\n' "$o"; return 0; fi
    if grep -qE '"status" *: *"FAILED"' <<<"$o"; then printf '%s\n' "$o"; return 1; fi
    [ "$SECONDS" -lt "$deadline" ] || { printf '%s\n' "$o"; return 1; }
    sleep 1
  done
}

# Ask PreFormServer to look for a printer at each given IP/hostname (no mDNS needed:
# the Local API's discover-devices probes one host directly). Prints one line per host.
probe_printers() {
  local ip o n name
  for ip in "$@"; do
    [[ "$ip" =~ ^[A-Za-z0-9._:-]+$ ]] || { log "ignoring printer address $ip (letters, digits, . _ : - only)"; continue; }
    if o="$(api_op /discover-devices/ "{\"ip_address\":\"$ip\",\"timeout_seconds\":$PREFORM_PRINTERS_TIMEOUT}" $((PREFORM_PRINTERS_TIMEOUT + 60)))"; then
      n="$(json_num count <<<"$o")"
      if [ "${n:-0}" -gt 0 ]; then
        name="$(json_str product_name <<<"$o")"
        log "printer at $ip: ${name:-unknown model} ($(json_str id <<<"$o"))"
      else log "no printer answered at $ip"; fi
    else
      log "probe of $ip failed: $(json_str message <<<"$o" | head -c 200)"
    fi
  done
}

configured_printers() { tr ', ' '\n\n' <<<"$PREFORM_PRINTERS" | grep -v '^$' || true; }

read_secret() { # read_secret VALUE FILE -> prints VALUE, or the file's first line
  if [ -n "$1" ]; then printf '%s' "$1"; elif [ -n "$2" ]; then [ -r "$2" ] || die "cannot read $2"; head -n1 "$2" | tr -d '\r\n'; fi
}

# Log in to Formlabs Web Services with the account from the environment, if any.
# Returns 0 when logged in or when no account is configured, 1 when the login failed.
account_login() {
  local token pass body o user
  token="$(read_secret "${FORMLABS_ACCESS_TOKEN:-}" "${FORMLABS_ACCESS_TOKEN_FILE:-}")"
  pass="$(read_secret "${FORMLABS_PASSWORD:-}" "${FORMLABS_PASSWORD_FILE:-}")"
  if [ -n "$token" ]; then body="{\"access_token\":\"$(json_escape "$token")\"}"
  elif [ -n "${FORMLABS_USERNAME:-}" ] && [ -n "$pass" ]; then body="{\"username\":\"$(json_escape "$FORMLABS_USERNAME")\",\"password\":\"$(json_escape "$pass")\"}"
  else return 0; fi
  if o="$(api_post /login/ "$body" 90)" && ! grep -q '"error"' <<<"$o"; then
    user="$(api_get /user/ 2>/dev/null | json_str username)"
    log "logged in to Formlabs as ${user:-${FORMLABS_USERNAME:-token user}}; Fleet Control and Dashboard printers are now available"
    return 0
  fi
  log "Formlabs login failed: $(json_str message <<<"$o" | head -c 200)"
  return 1
}

account_configured() { [ -n "${FORMLABS_ACCESS_TOKEN:-}${FORMLABS_ACCESS_TOKEN_FILE:-}" ] || { [ -n "${FORMLABS_USERNAME:-}" ] && [ -n "${FORMLABS_PASSWORD:-}${FORMLABS_PASSWORD_FILE:-}" ]; }; }

# Runs in the background once PreFormServer is up: account login, then the configured
# printers, re-probed every PREFORM_PRINTERS_INTERVAL seconds so /devices/ stays current.
after_ready() {
  local flag="$1" server_pid="$2" printers
  while [ ! -e "$flag" ]; do kill -0 "$server_pid" 2>/dev/null || return 0; sleep 1; done
  log "PreFormServer is ready at http://0.0.0.0:$PREFORM_PORT/"
  account_login || true
  mapfile -t printers < <(configured_printers)
  [ "${#printers[@]}" -gt 0 ] || return 0
  while :; do
    log "probing ${#printers[@]} configured printer(s): ${printers[*]}"
    probe_printers "${printers[@]}"
    [ "$PREFORM_PRINTERS_INTERVAL" -gt 0 ] 2>/dev/null || return 0
    sleep "$PREFORM_PRINTERS_INTERVAL"
    kill -0 "$server_pid" 2>/dev/null || return 0
  done
}

# --- commands ------------------------------------------------------------------------

cmd_install() {
  local force=0
  for a in "$@"; do case "$a" in --force) force=1 ;; *) die "unknown option $a" ;; esac; done
  for t in curl unzip; do have "$t" || die "$t is not installed"; done
  have_wine || die "wine is not installed (or set WINE to the binary)"
  check_wine_version

  local url version
  url="$(latest_release_url)"
  [ -n "$url" ] || die "no Windows PreFormServer $PREFORM_VERSION release found on $DOWNLOAD_PAGE"
  [[ "$url" =~ $RELEASE_URL_RE ]] || die "refusing unexpected download URL: $url"
  version="$(printf '%s' "$url" | awk -F/ '{ print $6 }')"

  if [ "$force" = 0 ] && [ "$(installed_version)" = "$version" ] && [ -f "$EXE" ]; then
    log "PreFormServer $version is already installed at $INSTALL_DIR"
  else
    local tmp
    mkdir -p "$PREFORM_LINUX_HOME"
    tmp="$(mktemp -d "$PREFORM_LINUX_HOME/tmp.XXXXXX")"
    # Expand now: tmp is local to this function and gone by the time the trap runs.
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT
    log "downloading PreFormServer $version (about 330 MB) from $url"
    curl -fL --max-time 1800 --max-filesize 1073741824 --retry 3 -A "preform-linux/$PREFORM_LINUX_VERSION" -o "$tmp/preform.zip" "$url"
    check_zip_entries "$tmp/preform.zip"
    log "extracting (the 1.1 GB debug symbols are skipped)"
    unzip -q "$tmp/preform.zip" -x '*.pdb' -d "$tmp/stage"
    verify_authenticode "$tmp/stage/PreFormServer/PreFormServer.exe"
    rm -rf "$INSTALL_DIR"
    mv "$tmp/stage/PreFormServer" "$INSTALL_DIR"
    printf 'version=%s\nurl=%s\ninstalled_at=%s\n' "$version" "$url" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$META"
    log "installed PreFormServer $version to $INSTALL_DIR"
  fi

  if needs_shim; then
    log "Wine $(wine_version) lacks DnsStartMulticastQuery; installing the dnsapi shim"
    build_shim "$INSTALL_DIR/dnsapi.dll"
  else
    rm -f "$INSTALL_DIR/dnsapi.dll"
  fi

  [ -f "$WINEPREFIX/system.reg" ] || init_prefix
  log "done. Next: preform-linux run"
}

launch_env() {
  [ "${PREFORM_TELEMETRY:-0}" = "1" ] || export DISABLE_PREFORMSERVER_TELEMETRY=1
  export QT_OPENGL="${QT_OPENGL:-software}"
  [ -f "$INSTALL_DIR/dnsapi.dll" ] && export WINEDLLOVERRIDES="dnsapi=n;$WINEDLLOVERRIDES"
  [ "${PREFORM_SHIM_TRACE:-0}" = "1" ] && export PREFORM_SHIM_TRACE
  return 0
}

# Pass PreFormServer's output through and mark the flag file once it reports ready.
relay_output() {
  local flag="$1" line
  while IFS= read -r line; do
    printf '%s\n' "$line"
    if [[ "$line" == *"$READY_TOKEN"* ]]; then touch "$flag"; fi
  done
}

cmd_run() {
  [ "${1:-}" = "--" ] && shift
  [ -f "$EXE" ] || die "PreFormServer is not installed; run: preform-linux install"
  check_wine_version
  [ -f "$WINEPREFIX/system.reg" ] || init_prefix
  launch_env

  local xvfb_pid="" display_file
  if [ -z "${DISPLAY:-}" ] || [ "${PREFORM_XVFB:-0}" = "1" ]; then
    have Xvfb || die "Xvfb is not installed (apt install xvfb)"
    display_file="$(mktemp)"
    Xvfb -displayfd 3 -screen 0 1280x1024x24 -nolisten tcp 3>"$display_file" >/dev/null 2>&1 &
    xvfb_pid=$!
    for _ in $(seq 1 100); do [ -s "$display_file" ] && break; sleep 0.1; done
    [ -s "$display_file" ] || die "Xvfb did not start"
    local display_no
    display_no="$(tr -d '[:space:]' <"$display_file")"
    export DISPLAY=":$display_no"
    rm -f "$display_file"
  fi

  local wine_pid="" watchdog_pid="" ready_pid="" ready_flag
  ready_flag="$(mktemp)"
  rm -f "$ready_flag"
  # shellcheck disable=SC2329  # invoked through the traps below
  cleanup() {
    trap - TERM INT EXIT
    [ -n "$watchdog_pid" ] && kill "$watchdog_pid" 2>/dev/null
    [ -n "$ready_pid" ] && kill "$ready_pid" 2>/dev/null
    if [ -n "$wine_pid" ] && kill -0 "$wine_pid" 2>/dev/null; then
      kill -TERM "$wine_pid" 2>/dev/null || true
      for _ in $(seq 1 50); do kill -0 "$wine_pid" 2>/dev/null || break; sleep 0.2; done
      kill -KILL "$wine_pid" 2>/dev/null || true
    fi
    wineserver -k 2>/dev/null || true
    [ -n "$xvfb_pid" ] && kill "$xvfb_pid" 2>/dev/null
    rm -f "$ready_flag"
    return 0
  }
  trap 'cleanup; exit 143' TERM INT
  trap cleanup EXIT

  disable_winedbg
  log "starting PreFormServer $(installed_version) on port $PREFORM_PORT (Wine $(wine_version), DISPLAY=$DISPLAY, QT_OPENGL=$QT_OPENGL${PREFORM_TELEMETRY:+, telemetry on})"
  # PreFormServer's output passes through a reader that notices the ready line.
  (cd "$INSTALL_DIR" && exec "$WINE" "$EXE" --port "$PREFORM_PORT" "$@") > >(relay_output "$ready_flag") 2>&1 &
  wine_pid=$!
  after_ready "$ready_flag" "$wine_pid" &
  ready_pid=$!
  if [ "$PREFORM_STARTUP_TIMEOUT" -gt 0 ] 2>/dev/null; then
    # A PreFormServer that never says READY (crash dialog, stuck loader) is killed so a
    # supervisor (systemd, Docker) can restart it instead of waiting forever.
    (
      sleep "$PREFORM_STARTUP_TIMEOUT"
      if [ ! -e "$ready_flag" ] && kill -0 "$wine_pid" 2>/dev/null; then
        log "PreFormServer did not report '$READY_TOKEN' within ${PREFORM_STARTUP_TIMEOUT}s; stopping it"
        kill -TERM "$wine_pid" 2>/dev/null
        sleep 5
        kill -KILL "$wine_pid" 2>/dev/null
        wineserver -k 2>/dev/null
      fi
    ) &
    watchdog_pid=$!
  fi
  set +e
  wait "$wine_pid"
  local status=$?
  set -e
  wine_pid=""
  log "PreFormServer exited with status $status"
  exit "$status"
}

cmd_doctor() {
  local v ok=1
  echo "preform-linux $PREFORM_LINUX_VERSION"
  echo "home:            $PREFORM_LINUX_HOME"
  echo "prefix:          $WINEPREFIX $([ -f "$WINEPREFIX/system.reg" ] && echo '(initialised)' || echo '(not initialised)')"
  if v="$(wine_version)" && [ -n "$v" ]; then
    echo "wine:            $("$WINE" --version) at $(command -v "$WINE")"
    if ! version_ge "$v" "$WINE_MIN"; then echo "                 TOO OLD: PreFormServer needs Wine >= $WINE_MIN (ICU DLLs). Install WineHQ devel."; ok=0; fi
    if version_ge "$v" "$WINE_MIN_FOR_NO_SHIM"; then echo "dnsapi:          Wine >= $WINE_MIN_FOR_NO_SHIM implements DnsStartMulticastQuery; no shim needed"
    else echo "dnsapi:          Wine < $WINE_MIN_FOR_NO_SHIM; the shim is required $(have x86_64-w64-mingw32-gcc && echo '(mingw-w64 found)' || echo '(install gcc-mingw-w64-x86-64 or upgrade Wine)')"; fi
  else echo "wine:            MISSING"; ok=0; fi
  for t in Xvfb xvfb-run curl unzip osslsigncode openssl; do
    if have "$t"; then echo "$(printf '%-16s' "$t:") $(command -v "$t")"; else echo "$(printf '%-16s' "$t:") missing"; [ "$t" = osslsigncode ] || [ "$t" = openssl ] || ok=0; fi
  done
  if [ -f "$WINEPREFIX/system.reg" ]; then
    if grep -A8 'AeDebug\]' "$WINEPREFIX/system.reg" 2>/dev/null | grep -q '"Auto"=dword:00000000'; then echo "winedbg:         auto-attach disabled (crashes exit)"
    else echo "winedbg:         auto-attach not persisted yet (run disables it at every start)"; fi
  fi
  if [ -f "$EXE" ]; then
    echo "PreFormServer:   $(installed_version) at $INSTALL_DIR$([ -f "$INSTALL_DIR/dnsapi.dll" ] && echo ' (dnsapi shim installed)')"
  else echo "PreFormServer:   not installed (run: preform-linux install)"; ok=0; fi
  if have curl; then
    local latest; latest="$(PREFORM_VERSION=latest latest_release_url 2>/dev/null | awk -F/ '{ print $6 }')"
    [ -n "$latest" ] && echo "latest release:  $latest"
  fi
  echo "port:            $PREFORM_PORT$(have ss && ss -ltn 2>/dev/null | grep -q ":$PREFORM_PORT " && echo ' (something is listening)')"
  echo "printers:        ${PREFORM_PRINTERS:-none configured (PREFORM_PRINTERS=ip,ip probes them at start; print_to_printer also takes an IP directly)}"
  echo "account:         $(account_configured && echo 'configured (FORMLABS_* set; login happens at start)' || echo 'not configured (only needed for Fleet Control / Dashboard printing)')"
  if have curl && api_up; then
    local dev; dev="$(api_get /devices/ 2>/dev/null || true)"
    echo "server:          answering, $(json_num count <<<"$dev" || echo '?') known device(s)$(api_get /user/ 2>/dev/null | json_str username | sed 's/^./, logged in as &/')"
  fi
  [ "$ok" = 1 ]
}

cmd_printers() {
  have curl || die "curl is not installed"
  api_up || die "PreFormServer is not answering on $API_BASE (is it running?)"
  local printers=("$@")
  [ "${#printers[@]}" -gt 0 ] || mapfile -t printers < <(configured_printers)
  [ "${#printers[@]}" -gt 0 ] && probe_printers "${printers[@]}"
  api_get /devices/
  echo
}

cmd_login() {
  have curl || die "curl is not installed"
  api_up || die "PreFormServer is not answering on $API_BASE (is it running?)"
  account_configured || die "no account configured: set FORMLABS_USERNAME and FORMLABS_PASSWORD (or FORMLABS_ACCESS_TOKEN)"
  account_login || exit 1
  api_get /user/
  echo
}

cmd_uninstall() {
  log "removing $INSTALL_DIR and $WINEPREFIX"
  wineserver -k 2>/dev/null || true
  rm -rf "$INSTALL_DIR" "$WINEPREFIX" "$META"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install)   cmd_install "$@" ;;
  run)       cmd_run "$@" ;;
  doctor)    cmd_doctor ;;
  printers)  cmd_printers "$@" ;;
  login)     cmd_login ;;
  wine)      launch_env; with_display "$WINE" "$@" ;;
  uninstall) cmd_uninstall ;;
  version|--version) echo "$PREFORM_LINUX_VERSION" ;;
  ""|help|-h|--help) sed -n '2,/^set -euo/{/^set -euo/!p;}' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd (try: preform-linux help)" ;;
esac
