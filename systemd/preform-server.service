# User unit for a bare-metal install. Install with:
#   mkdir -p ~/.config/systemd/user && cp systemd/preform-server.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now preform-server
# Adjust ExecStart to where you cloned preform-linux. Keep an account password in
# a root-readable-only file via EnvironmentFile= or FORMLABS_PASSWORD_FILE=, not here.
[Unit]
Description=Formlabs PreFormServer (Wine)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/preform-linux/bin/preform-linux run
Environment=PREFORM_PORT=44388
# Printers by IP (no mDNS under Wine); probed at start and every PREFORM_PRINTERS_INTERVAL seconds.
#Environment=PREFORM_PRINTERS=10.0.0.21,10.0.0.22
# Formlabs account for Fleet Control / Dashboard printing.
#Environment=FORMLABS_USERNAME=me@example.com
#Environment=FORMLABS_PASSWORD_FILE=%h/.config/preform-linux/password
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
